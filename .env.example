# ==============================================================================
# FloodVoice Configuration
# ก๊อบปี้ไฟล์นี้ไปเป็น .env แล้วกรอกค่า API Key ที่ต้องการใช้งาน
# ==============================================================================

# --- 1. AI Provider (เลือกใช้อย่างน้อย 1 ตัว) ---
# แนะนำ: Google Gemini API (ฟรี ไม่ต้องใช้บัตรเครดิต ขอได้ที่ https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# ทางเลือก: OpenAI API (สำหรับ Whisper STT และ GPT-4o-mini)
OPENAI_API_KEY=your_openai_api_key_here

# ตัวเลือก AI ที่ต้องการใช้หลัก: "gemini" หรือ "openai" (ค่าเริ่มต้น: gemini)
DEFAULT_AI_PROVIDER=gemini

# --- 2. Google Sheets Export (ทางเลือกสำหรับแสดงผล Real-time) ---
# ID ของ Google Spreadsheet ที่ต้องการบันทึกข้อมูล (ดูได้จาก URL ของ Sheet)
GOOGLE_SHEET_ID=
# Path ของไฟล์ Google Service Account JSON (ถ้าใช้)
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# --- 3. Supabase Database (ทางเลือกสำหรับฐานข้อมูลกลาง) ---
SUPABASE_URL=
SUPABASE_KEY=

# --- 4. Telegram Alert Dispatcher (ทางเลือกสำหรับแจ้งเตือนเข้ากลุ่มกู้ภัย) ---
# ขอ Bot Token จาก @BotFather ใน Telegram
TELEGRAM_BOT_TOKEN=
# Chat ID หรือ Group ID (เช่น -100xxxxxxxxxx)
TELEGRAM_CHAT_ID=

# --- 5. Social Media Scraping / Search APIs (ทางเลือก) ---
# YouTube Data API v3 Key (ขอฟรีได้ที่ Google Cloud Console เพื่อค้นหา Live Stream)
YOUTUBE_API_KEY=
# Apify Token สำหรับดึง Facebook / TikTok Feed
APIFY_TOKEN=

# --- 6. General Settings ---
# โหมดเก็บข้อมูลในเครื่องเมื่อไม่มี Supabase (SQLite): true หรือ false
USE_LOCAL_SQLITE=true
# ไดเรกทอรีสำหรับส่งออกไฟล์ Markdown ของ Obsidian
OBSIDIAN_EXPORT_DIR=./obsidian_vault
# รอบเวลาการสแกนอัตโนมัติ (นาที)
SCAN_INTERVAL_MINUTES=15
